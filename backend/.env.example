# ==============================================================================
# PROJECT TIRITH - ENVIRONMENT CONFIGURATION
# 
# Copy this file to `.env` and replace the placeholder values with your own.
# WARNING: Never commit your actual `.env` file to version control.
# ==============================================================================

# --- 1. Database Configuration ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
# Use 'localhost' for bare-metal development. 
# Use 'db' if running the application entirely inside Docker Compose.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/tirith"

# --- 2. Security & Authentication ---
# Cryptographic key used to sign JWT session tokens.
# IN PRODUCTION: Generate a secure 32-byte key using: `openssl rand -hex 32`
SECRET_KEY="replace-this-with-a-highly-secure-random-string-in-production"

# (Optional) Override default token expiration limits
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=30

# --- 3. Third-Party Integrations ---
# Resend API Key for dispatching password recovery emails
# Leave blank during local testing if email delivery is not required
RESEND_API_KEY="re_123456789_placeholder"